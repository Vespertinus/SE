
include "Mesh.fbs";
include "Material.fbs";
include "Audio.fbs";
include "SoundEmitter.fbs";
include "AnimationSkeleton.fbs";
include "AnimationGraph.fbs";
include "StateMachine.fbs";
include "Terrain.fbs";
include "Spawner.fbs";
include "NavMesh.fbs";
include "Blackboard.fbs";
include "BehaviorTree.fbs";

namespace SE.FlatBuffers;

//Resource:

//Builtin components:

table StaticModel {
        mesh:MeshHolder (required);
        materials:[MaterialHolder];
}

table BindSQT {

        bind_rot:Vec4;
        bind_pos:Vec3;
        bind_scale:Vec3;
}

table CharacterShell {
        skeleton_root_node:string (required);
}

table AnimatedModel {
        mesh:MeshHolder (required);
        materials:[MaterialHolder];
        //blendshapes or skeleton must exist
        blendshapes:TextureHolder;//or as vertex buffer
        blendshapes_weights:[float];
        skeleton:SkeletonHolder;
        skeleton_root_node:string;
        joints_indexes:[uint16];
        joints_inv_bind_pose:[BindSQT];
        mesh_bind_pos:BindSQT;
}

//Component wrappers

table AppComponent {
        sub_type:uint16;
        data:[ubyte] (flexbuffer);
}

table BoxCollider {
        half_extents:Vec3 (required);
}

table SphereCollider {
        radius:float = 0.5;
}

table CapsuleCollider {
        radius:float = 0.5;
        half_height:float = 0.5;
}

table MeshCollider {
        vertices:[float];   // flattened vec3 triples: x0,y0,z0, x1,y1,z1, ...
        indices:[uint32];
}

union ColliderU {
        BoxCollider,
        SphereCollider,
        CapsuleCollider,
        MeshCollider
}

table RigidBody {
        collider:ColliderU (required);
        initial_rotation:Vec4;        // quaternion stored as (x,y,z,w) — matches glm::quat memory layout
        is_static:bool        = false;
        is_kinematic:bool     = false;
        is_trigger:bool       = false;
        friction:float        = 0.5;
        restitution:float     = 0.0;
        linear_damping:float  = 0.05;
        angular_damping:float = 0.05;
        gravity_scale:float   = 1.0;
        mass:float            = 1.0;
        collision_layer:uint  = 1;
        collision_mask:uint   = 4294967295;
}

table Animator {
        animation_graph: AnimationGraphHolder (required);
}

table TriggerVolume {
        collider        : ColliderU (required);
        on_enter_event  : string;
        on_exit_event   : string;
        on_stay_event   : string;
        stay_interval   : float = 0.0;
        one_shot        : bool  = false;
        collision_layer : uint  = 1;
        collision_mask  : uint  = 4294967295;
}

table StateMachine {
        hms           : StateMachineHolder (required);
        tick_interval : float = 0.0;
}

// per-entity blackboard instance. The schema (keys + types +
// defaults) is the referenced .sebb asset; `initial` overrides defaults per
// instance (each guard bakes a different home post) and is validated at load.
table Blackboard {
        bb      : BlackboardHolder (required);
        initial : [BlackboardInitial];
}

// authored trigger→blackboard writes. Inert marker placed on the
// same node as a TriggerVolume; BlackboardSystem dispatches on ETriggerFired.
// Matching by on_event covers enter/exit/stay uniformly ("occupied = false" is an
// on_exit binding). Value must match the target key's schema type; write_position
// instead stores the entering actor's position into a Vec3 key.
enum TriggerBBTarget : byte {
        Global = 0,   // the world-level blackboard (WorldSystem::GetGlobalBlackboard)
        Self   = 1,   // the trigger node's own Blackboard component
}

table TriggerBindingDef {
        on_event       : string (required);
        target         : TriggerBBTarget = Global;
        key            : string (required);
        value          : BBValueU;
        write_position : bool = false;
}

table TriggerBinding {
        bindings : [TriggerBindingDef] (required);
}

// Behavior-tree brain. The tree structure is the referenced
// .sebt asset; runtime state (node statuses, timers, task memory) lives per
// instance. tick_interval staggers the tree's ticks (0 = every frame); the
// scheduler phase-seeds from the entity name so agents never tick in lockstep.
table BehaviorTree {
        tree          : BehaviorTreeHolder (required);
        tick_interval : float = 0.0;
}

// Heightfield terrain. One per terrain-bearing sub-level
// (component mode: tiles activate with this node) or per world-level grid node
// (grid_mode: tiles page by distance; this node only renders).
table TerrainComponent {
        manifest : string (required);   // .seterrain path
        grid_mode: bool = false;
}

// Gameplay spatial-index marker (world query grid: spawner
// conditions, perception, streaming-context queries). One point/radius of
// interest; position comes from the node transform.
table SpatialEntry {
        tag       : string (required);
        radius    : float = 0.0;
        track_node: bool  = false;   // entry position follows the node transform
}

// Interior/world portal — the reusable door↔sub-level link.
// While any streaming focus (player, ...) is inside activate_radius of this
// node, the referenced Manual sub-level is staged through the budgeted drain;
// past release_radius (> activate: hysteresis band) it is released again.
// Levels the streaming director already manages are ignored.
table Portal {
        level_path     : string (required);   // sub-level path inside the .seworld
        activate_radius: float  = 22.0;
        release_radius : float  = 34.0;
}

union ComponentU {
        StaticModel,
        AnimatedModel,
        RigidBody,
        AudioEmitter,
        AudioListener,
        SoundEmitter,
//        Camera,
//        Light,
//        etc
        AppComponent,
        Animator,
        TriggerVolume,
        StateMachine,
        TerrainComponent,
        SpatialEntry,
        SpawnPoint,
        SpawnVolume,
        Population,
        NavArea,
        NavLink,
        NavAgent,
        PathFollower,
        TriggerBinding,
        Blackboard,
        BehaviorTree,
        Portal,
}

table Component {

        component:ComponentU (required);
}

root_type Component;

